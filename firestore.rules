rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;  // Allow any authenticated user to read
      allow write: if request.auth != null && request.auth.uid == userId;  // Only allow users to modify their own data
    }
    
    // Other rules...
  }
} 