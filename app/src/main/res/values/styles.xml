<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dropdown styles -->
    <style name="Widget.MinuteBurgers.DropDown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/minute_burger_orange</item>
        <item name="hintTextColor">@color/minute_burger_orange</item>
        <item name="android:textColorHint">@color/minute_burger_orange</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="endIconTint">@color/minute_burger_orange</item>
    </style>

    <!-- Text input styles -->
    <style name="Widget.MinuteBurgers.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/minute_burger_orange</item>
        <item name="hintTextColor">@color/minute_burger_orange</item>
        <item name="android:textColorHint">@color/minute_burger_orange</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="errorTextColor">@color/error_red</item>
        <item name="errorIconTint">@color/error_red</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.MinuteBurgers.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/minute_burger_orange</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="elevation">2dp</item>
        <item name="rippleColor">@color/minute_burger_orange_light</item>
    </style>

    <style name="Widget.MinuteBurgers.Button.Dark" parent="Widget.MinuteBurgers.Button">
        <item name="backgroundTint">@color/minute_burger_orange_dark</item>
        <item name="rippleColor">@color/minute_burger_orange</item>
    </style>

    <style name="Widget.MinuteBurgers.Button.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/minute_burger_orange</item>
        <item name="strokeColor">@color/minute_burger_orange</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">@color/minute_burger_orange_light</item>
    </style>

    <!-- Card styles -->
    <style name="Widget.MinuteBurgers.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="rippleColor">@color/minute_burger_orange_light</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- Toolbar styles -->
    <style name="Widget.MinuteBurgers.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/minute_burger_orange</item>
        <item name="titleTextColor">@color/white</item>
        <item name="titleTextAppearance">@style/TextAppearance.MinuteBurgers.Toolbar.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.MinuteBurgers.Toolbar.Subtitle</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Text appearance styles -->
    <style name="TextAppearance.MinuteBurgers.Toolbar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.MinuteBurgers.Toolbar.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:alpha">0.8</item>
    </style>

    <style name="TextAppearance.MinuteBurgers.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextAppearance.MinuteBurgers.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/gray</item>
    </style>

    <!-- Dark mode text input styles -->
    <style name="Widget.MinuteBurgers.TextInputLayout.Dark" parent="Widget.MinuteBurgers.TextInputLayout">
        <item name="boxStrokeColor">@color/minute_burger_orange_light</item>
        <item name="hintTextColor">@color/minute_burger_orange_light</item>
        <item name="android:textColorHint">@color/minute_burger_orange_light</item>
        <item name="boxBackgroundColor">@color/background_dark</item>
    </style>

    <!-- Exposed dropdown menu style -->
    <style name="Widget.MinuteBurgers.TextInputLayout.ExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/minute_burger_orange</item>
        <item name="hintTextColor">@color/minute_burger_orange</item>
        <item name="android:textColorHint">@color/minute_burger_orange</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="endIconTint">@color/minute_burger_orange</item>
    </style>

    <!-- Shape appearance styles -->
    <style name="ShapeAppearance.Material3.Corner.Full" parent="">
        <item name="cornerSize">50%</item>
        <item name="cornerFamily">rounded</item>
    </style>
</resources>