<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MinuteBurgers" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/minute_burger_orange</item>
        <item name="colorPrimaryVariant">@color/minute_burger_orange_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_color</item>
        <item name="colorSecondaryVariant">@color/secondary_color</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <!-- Default text colors -->
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorSecondary">@color/light_gray</item>
        <!-- Card styles -->
        <item name="cardBackgroundColor">@color/background_dark</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.MinuteBurgers.Button.Dark</item>
        <!-- Text field styles -->
        <item name="textInputStyle">@style/Widget.MinuteBurgers.TextInputLayout.Dark</item>
        <!-- Background color -->
        <item name="android:windowBackground">@color/primary_dark</item>
        <!-- Animation -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@android:transition/explode</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
        <!-- Ripple effect -->
        <item name="colorControlHighlight">@color/minute_burger_orange_light</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.MinuteBurgers.Splash" parent="Theme.MinuteBurgers">
        <item name="android:windowBackground">@color/minute_burger_orange_dark</item>
        <item name="android:statusBarColor">@color/minute_burger_orange_dark</item>
        <item name="android:navigationBarColor">@color/minute_burger_orange_dark</item>
    </style>
</resources>